{
  "name": "Native Role-Aware World-Model PPO v7",
  "description": "PPO + separate current/next-card roles + spatial combat counts and total HP + action-conditioned auxiliary dynamics",
  "trainer": "training_runtime:run_sb3_training",
  "environment": "native_engine.native_vec_env:NativeBatchVecEnv",
  "algorithm": "native_engine.native_recurrent_model:NativeActionConditionedWorldModelPPO",
  "policy": "native_engine.native_recurrent_model:NativeRoleAwareActionConditionedWorldModelRecurrentPolicy",
  "defaults": {
    "rounds": 10,
    "rollout_decisions": 8192,
    "battles": 16,
    "decision_ticks": 10,
    "port": 26789,
    "seed": 0,
    "device": "mps",
    "checkpoint_every_rounds": 5,
    "batch_size": 512,
    "epochs_per_round": 4,
    "learning_rate": 0.0003,
    "gamma": 0.997,
    "gae_lambda": 0.95,
    "entropy_coef": 1.0,
    "clip_range": 0.2,
    "recurrent_enabled": true,
    "tbptt_steps": 32,
    "recurrent_hidden_size": 256,
    "recurrent_layers": 1,
    "cross_modal_enabled": true,
    "cross_modal_dim": 64,
    "cross_modal_heads": 4,
    "cross_modal_entity_layers": 2,
    "spatial_heatmap_enabled": true,
    "spatial_feature_channels": 64,
    "world_model_enabled": true,
    "world_model_hidden_dim": 128,
    "auxiliary_coef": 0.1,
    "auxiliary_horizon": 4,
    "auxiliary_weights": {
      "tower_delta": 1.0,
      "entity_death": 0.5,
      "entity_position": 0.5,
      "damage_source": 0.25,
      "opponent_elixir": 0.25,
      "opponent_hand": 0.25,
      "opponent_next_card": 0.25,
      "future_value": 0.5
    },
    "self_play_enabled": true,
    "self_play_random_ratio": 0.0,
    "self_play_current_ratio": 0.3,
    "self_play_historical_ratio": 0.7,
    "self_play_snapshot_every_rounds": 5,
    "self_play_pool_size": 20,
    "self_play_active_historical": 4,
    "self_play_loaded_model_limit": 4,
    "self_play_elo_k": 16.0,
    "fixed_evaluation_enabled": true,
    "evaluation_every_rounds": 5,
    "evaluation_seed_base": 900001,
    "evaluation_seed_count": 16,
    "evaluation_battles": 16,
    "evaluation_max_decisions": 1024,
    "evaluation_opponents": ["random", "initial_policy"]
  },
  "environment_kwargs": {
    "learner_roles": "alternating",
    "observation_schema": "native_model_v4"
  },
  "algorithm_kwargs": {}
}
